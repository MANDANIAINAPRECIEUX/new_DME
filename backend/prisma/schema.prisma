// Prisma est un ORM qui permet au backend de manipuler PostgreSQL depuis JavaScript.
// Ce fichier décrit les modèles de données, leurs champs et leurs relations.
// Prisma génère un client pour interroger la base et fournit des migrations pour faire évoluer sa structure.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  M
  F
}

enum AppointmentStatus {
  pending
  completed
  cancelled
}

enum TreatmentStatus {
  ongoing
  completed
}

// Informations générales du patient.
// L'âge est calculé depuis birthDate.
model Patient {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  gender    Gender
  birthDate DateTime @db.Date
  phone     String
  address   String?

  appointments Appointment[]
  treatments   Treatment[]

  @@index([lastName, firstName])
}

// Clerk gère la connexion et les mots de passe.
// clerkUserId relie le docteur à son compte Clerk.
// Seuls les comptes explicitement liés à un docteur sont autorisés.
model Doctor {
  id           Int     @id @default(autoincrement())
  clerkUserId  String? @unique
  firstName    String
  lastName     String
  email        String  @unique

  // Ancien champ conservé pendant la transition, inutilisé par Clerk.
  passwordHash String?
  photo        String?
  speciality   String

  appointments  Appointment[]
  consultations Consultation[]
}


// Chaque rendez-vous appartient à un patient et à un docteur.
// Le backend impose un créneau d'une heure à une heure entière.
model Appointment {
  id        Int               @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime          @db.Date
  time      String            @db.VarChar(5)
  status    AppointmentStatus @default(pending)
  reason    String?

  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor       Doctor        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  consultation Consultation?

  @@index([patientId, date])
  @@index([doctorId, date, time])
}

// Un traitement appartient à un seul patient.
// Il peut être créé avant sa première consultation.
model Treatment {
  id          Int             @id @default(autoincrement())
  patientId   Int
  label       String
  status      TreatmentStatus @default(ongoing)
  startDate   DateTime        @db.Date
  endDate     DateTime?       @db.Date
  observation String?

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  consultations Consultation[]

  @@index([patientId, status])
}

// Une consultation provient d'un seul rendez-vous.
// Son patient est retrouvé via ce rendez-vous.
// Le rattachement à un traitement est facultatif.
model Consultation {
  id               Int      @id @default(autoincrement())
  appointmentId    Int      @unique
  treatmentId      Int?
  doctorId         Int
  consultationDate DateTime @db.Date
  compteRendu      String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  treatment   Treatment?  @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Restrict)

  @@index([treatmentId, consultationDate])
  @@index([doctorId, consultationDate])
payments Payment[]
  soins Soin[]
}


// Catalogue des soins proposés par le cabinet.
// Le tarif est fixe et stocké en décimal pour éviter les erreurs d'arrondi.
model TypeSoin {
  id    Int     @id @default(autoincrement())
  label String
  tarif Decimal @db.Decimal(10, 2)

  soins Soin[]
}

// Acte effectué pendant une consultation.
// Le tarif est obtenu depuis le type de soin.
model Soin {
  id             Int     @id @default(autoincrement())
  consultationId Int
  typeSoinId     Int
  observation    String?

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)
  typeSoin     TypeSoin     @relation(fields: [typeSoinId], references: [id], onDelete: Restrict)
  dents        SoinDent[]

  @@index([consultationId])
  @@index([typeSoinId])
}

// Référentiel des numéros de dents, commun à tous les patients.
// L'état d'une dent d'un patient n'est pas enregistré ici.
model Dent {
  id     Int    @id @default(autoincrement())
  number String @unique @db.VarChar(2)

  soins SoinDent[]
}

// Association entre un soin réalisé et les dents concernées.
model SoinDent {
  soinId Int
  dentId Int

  soin Soin @relation(fields: [soinId], references: [id], onDelete: Restrict)
  dent Dent @relation(fields: [dentId], references: [id], onDelete: Restrict)

  @@id([soinId, dentId])
  @@index([dentId])
}

// Une consultation peut recevoir plusieurs paiements.
// Le patient est retrouvé via le rendez-vous de la consultation.
model Payment {
  id             Int      @id @default(autoincrement())
  consultationId Int
  paymentDate    DateTime @db.Date
  amount         Decimal  @db.Decimal(10, 2)
  remark         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict)

  @@index([consultationId])
  @@index([paymentDate])
}
