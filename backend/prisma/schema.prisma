// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma est un ORM qui permet au backend de manipuler PostgreSQL depuis JavaScript.
// Ce fichier décrit les modèles de données, leurs champs et leurs relations.
// Prisma génère un client pour interroger la base et fournit des migrations pour faire évoluer sa structure.

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Gender {
  M
  F
}

// Informations générales du patient.
// L'âge sera calculé depuis birthDate, sans être enregistré.
model Patient {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String
  gender    Gender
  birthDate DateTime @db.Date
  phone     String
  address   String?

  @@index([lastName, firstName])
}