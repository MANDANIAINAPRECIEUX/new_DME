// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma est un ORM qui permet au backend de manipuler PostgreSQL depuis JavaScript.
// Ce fichier décrit les modèles de données, leurs champs et leurs relations.
// Prisma génère un client pour interroger la base et fournit des migrations pour faire évoluer sa structure.

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  M
  F
}

// Informations générales du patient.
// L'âge sera calculé depuis birthDate, sans être enregistré.
model Patient {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  gender    Gender
  birthDate DateTime @db.Date
  phone     String
  address   String?

  @@index([lastName, firstName])

  appointments Appointment[]
}


// Le docteur utilise son email pour se connecter.
// Seul le hash du mot de passe est enregistré.
model Doctor {
  id           Int     @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String  @unique
  passwordHash String
  photo        String?
  speciality   String
}



enum AppointmentStatus {
  pending
  completed
  cancelled
}

// Chaque rendez-vous appartient à un patient et à un docteur.
// Un créneau dure une heure et commence à une heure entière.
model Appointment {
  id        Int               @id @default(autoincrement())
  patientId Int
  doctorId  Int
  date      DateTime          @db.Date
  time      String            @db.VarChar(5)
  status    AppointmentStatus @default(pending)
  reason    String?

  patient Patient @relation(
    fields: [patientId],
    references: [id],
    onDelete: Restrict
  )

  doctor Doctor @relation(
    fields: [doctorId],
    references: [id],
    onDelete: Restrict
  )

  @@index([patientId, date])
  @@index([doctorId, date, time])
}

enum TreatmentStatus {
  ongoing
  completed
}

// Un traitement appartient à un seul patient.
// Il peut être créé avant sa première consultation.
model Treatment {
  id          Int             @id @default(autoincrement())
  patientId   Int
  label       String
  status      TreatmentStatus @default(ongoing)
  startDate   DateTime        @db.Date
  endDate     DateTime?       @db.Date
  observation String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)

  @@index([patientId, status])
}


